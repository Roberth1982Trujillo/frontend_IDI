# URL pública del Backend (incluyendo /api).
# Vite la incrusta en el build, por lo que debe definirse ANTES de compilar/desplegar.
#
# Desarrollo local (por defecto se usa el proxy de Vite hacia el puerto 8088):
# VITE_API_BASE_URL=http://localhost:8088/api
#
# Producción en Railway (Variables del servicio frontend_IDI):
# VITE_API_BASE_URL=https://backendidi-production.up.railway.app/api
VITE_API_BASE_URL=http://localhost:8088/api
